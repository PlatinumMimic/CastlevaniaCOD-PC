{
  "name": "aa",
  "after": "newgame.json",
  "vendor": true,
  "needs": [
    "env:CV_VENDOR_DIR"
  ],
  "platforms": [
    "windows"
  ],
  "note": "Anti-aliasing and upscaling by AMD FSR (the SDK's framegen.cpp and d3d12.cpp AntiAliasFrame), its signed libraries beside the game from CV_VENDOR_DIR as the launcher downloads them: FSR on the courtyard's 3D, switched off and on again while playing, then upscaling at Performance (the 3D drawn at half the window's size, made up to it: softer, its edges weaker than at native) and back to native. FSR's sharpening leaves native edges about as strong as without it, so those are not compared. Ambient occlusion off, so the edges are the anti-aliasing's alone.",
  "settings": {
    "width": 1280,
    "height": 720,
    "antialiasing": 1,
    "upscaling": 0,
    "ambient_occlusion": 0
  },
  "steps": [
    {
      "press": "0f:wait:90f",
      "shot": "fsr",
      "measure": {
        "rail": [
          0.05,
          0.1,
          0.4,
          0.22
        ],
        "wall": [
          0.0,
          0.25,
          0.4,
          0.5
        ],
        "floor": [
          0.0,
          0.83,
          1.0,
          1.0
        ]
      },
      "expect": [
        "aa.kind == 1",
        "aa.drawn == [1280, 720]",
        "found(runlog, r'antialias: AMD FSR on the frame.s 3D at 1280x720')",
        "not found(runlog, 'is not signed')"
      ]
    },
    {
      "press": "0:set=antialiasing=0,0f:wait:30f",
      "shot": "off",
      "measure": {
        "rail": [
          0.05,
          0.1,
          0.4,
          0.22
        ],
        "wall": [
          0.0,
          0.25,
          0.4,
          0.5
        ],
        "floor": [
          0.0,
          0.83,
          1.0,
          1.0
        ]
      },
      "expect": [
        "aa.kind == 0"
      ]
    },
    {
      "press": "0:set=antialiasing=1,0:set=upscaling=3,0f:wait:60f",
      "shot": "fsr-performance",
      "measure": {
        "rail": [
          0.05,
          0.1,
          0.4,
          0.22
        ],
        "wall": [
          0.0,
          0.25,
          0.4,
          0.5
        ],
        "floor": [
          0.0,
          0.83,
          1.0,
          1.0
        ]
      },
      "expect": [
        "aa.kind == 1",
        "aa.drawn == [640, 360]",
        "aa.output == [1280, 720]",
        "found(runlog, r'upscaling: the 3D drawn at 640x360, made up to 1280x720')",
        "screen.edges.wall < shots['fsr'].edges.wall * 0.85"
      ]
    },
    {
      "press": "0:set=upscaling=0,0f:wait:30f",
      "shot": "fsr-native",
      "expect": [
        "aa.drawn == [1280, 720]"
      ]
    }
  ]
}
