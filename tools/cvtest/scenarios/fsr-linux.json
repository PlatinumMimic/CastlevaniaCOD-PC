{
  "name": "fsr-linux",
  "after": "newgame.json",
  "note": "Linux's anti-aliasing and upscaling by AMD FSR 3 on Vulkan (the SDK's linux/fsr_vk.cpp, the FidelityFX SDK 1.1.4's Linux fork): on the 3D, still from frame to frame, off and on, Performance upscaling (640x360 made up to 1280x720), the camera turned and back at full size, as the own TAA's test checks it (taa). Run on the dev build made with XBE_FSR_VK_DIR, as a release is.",
  "settings": {
    "width": 1280,
    "height": 720,
    "antialiasing": 1,
    "upscaling": 0,
    "ambient_occlusion": 0
  },
  "steps": [
    {
      "press": "0f:wait:90f",
      "shot": "taa",
      "measure": {
        "rail": [
          0.05,
          0.1,
          0.4,
          0.22
        ],
        "wall": [
          0.0,
          0.25,
          0.4,
          0.5
        ],
        "floor": [
          0.0,
          0.83,
          1.0,
          1.0
        ]
      },
      "expect": [
        "aa.kind == 1",
        "aa.drawn == [1280, 720]",
        "found(runlog, r'antialias: AMD FSR .Vulkan. on the frame.s 3D at 1280x720')",
        "found(runlog, r'AMD FSR 3 on Vulkan')"
      ]
    },
    {
      "press": "0f:wait:20f",
      "shot": "taa-still",
      "differs": {
        "upper": [
          "taa",
          0.55,
          0.15,
          1.0,
          0.65
        ]
      }
    },
    {
      "press": "0:set=antialiasing=0,0f:wait:30f",
      "shot": "off",
      "measure": {
        "rail": [
          0.05,
          0.1,
          0.4,
          0.22
        ],
        "wall": [
          0.0,
          0.25,
          0.4,
          0.5
        ],
        "floor": [
          0.0,
          0.83,
          1.0,
          1.0
        ]
      },
      "differs": {
        "upper": [
          "taa",
          0.55,
          0.15,
          1.0,
          0.65
        ]
      },
      "expect": [
        "aa.kind == 0"
      ]
    },
    {
      "press": "0:set=antialiasing=1,0:set=upscaling=3,0f:wait:60f",
      "shot": "taa-performance",
      "measure": {
        "rail": [
          0.05,
          0.1,
          0.4,
          0.22
        ],
        "wall": [
          0.0,
          0.25,
          0.4,
          0.5
        ],
        "floor": [
          0.0,
          0.83,
          1.0,
          1.0
        ]
      },
      "expect": [
        "aa.kind == 1",
        "aa.drawn == [640, 360]",
        "aa.output == [1280, 720]",
        "found(runlog, r'upscaling: the 3D drawn at 640x360, made up to 1280x720 by AMD FSR .Vulkan.')"
      ]
    },
    {
      "press": "0:set=upscaling=0,0f:rs=0.7/0:40f",
      "shot": "taa-turn",
      "expect": [
        "not screen.flat"
      ]
    },
    {
      "press": "0f:wait:30f",
      "shot": "taa-native",
      "expect": [
        "aa.drawn == [1280, 720]"
      ]
    }
  ]
}
