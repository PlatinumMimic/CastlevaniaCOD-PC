{
  "name": "menu-pad",
  "after": "newgame.json",
  "env": {
    "XBE_VIRTUAL_PAD": "1"
  },
  "note": "The in-game settings menu by controller alone (src/common/menu.cpp; the SDK's virtual controller, XBE_VIRTUAL_PAD): both sticks clicked open it, RB (the Xbox's black) and LB (white) turn its pages either way round (Display, Graphics, View, Game, Controls, Tools), B closes it; opened again, Start closes it, and the Start held as it closes does not reach the game, whose pause menu stays shut. The D-pad moves to a setting and A switches it, on and off again. On the drawbridge the right stick turns the camera under the menu.",
  "steps": [
    {
      "press": "0f:l3+r3:5f,10f:wait:20f",
      "shot": "open",
      "expect": [
        "settings_menu",
        "'vsync' in menu_controls"
      ]
    },
    {
      "press": "0f:black:5f,10f:wait:10f",
      "shot": "rb",
      "expect": [
        "settings_menu",
        "'aniso' in menu_controls"
      ]
    },
    {
      "press": "0f:black:5f,10f:wait:10f",
      "shot": "rb-2",
      "expect": [
        "'wide' in menu_controls"
      ]
    },
    {
      "press": "0f:white:5f,10f:wait:10f",
      "shot": "lb",
      "expect": [
        "'aniso' in menu_controls"
      ]
    },
    {
      "press": "0f:white:5f,10f:wait:10f",
      "expect": [
        "'vsync' in menu_controls"
      ]
    },
    {
      "press": "0f:white:5f,10f:wait:10f",
      "shot": "lb-wraps",
      "expect": [
        "settings_menu",
        "'vsync' not in menu_controls"
      ]
    },
    {
      "press": "0f:b:5f,20f:wait:20f",
      "shot": "b-closes",
      "expect": [
        "not settings_menu",
        "not menu"
      ]
    },
    {
      "press": "0f:l3+r3:5f,10f:wait:20f",
      "expect": [
        "settings_menu"
      ]
    },
    {
      "press": "0f:start:5f,30f:wait:30f",
      "shot": "start-closes",
      "expect": [
        "not settings_menu",
        "not menu"
      ]
    },
    {
      "press": "0f:l3+r3:5f,10f:wait:20f",
      "note": "the menu again",
      "expect": [
        "settings_menu"
      ]
    },
    {
      "press": "0f:white:5f,10f:wait:10f,20f:white:5f,30f:wait:10f",
      "note": "LB twice, from the Tools page it was left on to the Game page",
      "expect": [
        "'fpsc' in menu_controls"
      ]
    },
    {
      "press": "0f:down:5f,10f:wait:10f",
      "shot": "dpad",
      "note": "the D-pad down, to the FPS counter"
    },
    {
      "press": "0f:a:5f,10f:wait:10f",
      "shot": "a",
      "note": "A: the FPS counter switched on",
      "expect": [
        "saved.fps_counter == True"
      ]
    },
    {
      "press": "0f:a:5f,10f:wait:10f",
      "note": "A again: off",
      "expect": [
        "saved.fps_counter == False"
      ]
    },
    {
      "press": "0f:b:5f,20f:wait:20f",
      "expect": [
        "not settings_menu"
      ]
    },
    {
      "press": "0:warp=5.0,10f:wait:20f",
      "note": "the drawbridge, whose camera turns"
    },
    {
      "until": "room == 0 and player.active and not loading",
      "timeout": 40
    },
    {
      "press": "0f:l3+r3:5f,10f:wait:20f",
      "expect": [
        "settings_menu"
      ]
    },
    {
      "press": "0f:rsr:30f",
      "shot": "menu-camera",
      "note": "the right stick under the menu: the camera turns",
      "expect": [
        "settings_menu",
        "((camera.angles[1] - prev.camera.angles[1] + 3.14159) % 6.28318 - 3.14159) > 0.3"
      ]
    },
    {
      "press": "0f:l3+r3:5f,10f:wait:20f",
      "expect": [
        "not settings_menu"
      ]
    }
  ]
}
