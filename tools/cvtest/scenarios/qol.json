{
  "name": "qol",
  "after": "newgame.json",
  "note": "The HUD at the screen edges, the camera stick with and without inversion, the field of view and the far view (fog and draw distance 4x) on the drawbridge (5.0), then a fight in 5.12 for the game's rumble (CV_RUMBLE_TRACE): both motors. Then the rampart of 5.7 with fog and draw distance 4x: its sky's painted cards (a moon and strips past the room's far plane) keep the room's own fog. Checked by the telemetry: wide (the HUD's move), camera.angles (the turn, unwrapped), view (the field of view, far plane and fog as the game set them and as drawn) and wide.sky (the sky's draws given the room's fog).",
  "env": {"CV_RUMBLE_TRACE": "1"},
  "settings": {"width": 1600, "height": 900},
  "steps": [
    {"press": "0:warp=5.0,10f:wait:20f", "note": "the drawbridge"},
    {"until": "room == 0 and player.active and not loading", "timeout": 40},
    {"press": "0f:wait:90f", "shot": "hud-edges", "expect": ["wide.hud.move < 0"]},
    {"press": "0:set=hud_edges=false,0f:wait:20f", "shot": "hud-middle", "expect": ["wide.hud.move == 0"]},
    {"press": "0:set=hud_edges=true,0f:wait:10f"},
    {"press": "0f:rsr:30f", "shot": "cam-right", "expect": ["((camera.angles[1] - prev.camera.angles[1] + 3.14159) % 6.28318 - 3.14159) > 0.3"]},
    {"press": "0f:wait:20f"},
    {"press": "0:set=invert_camera_x=true,0f:rsr:30f", "shot": "cam-right-inverted", "expect": ["((camera.angles[1] - prev.camera.angles[1] + 3.14159) % 6.28318 - 3.14159) < -0.3"]},
    {"press": "0:set=invert_camera_x=false,0f:wait:10f"},
    {"press": "0f:rsu:30f", "shot": "cam-up", "expect": ["camera.angles[0] - prev.camera.angles[0] > 0.2"]},
    {"press": "0f:wait:20f"},
    {"press": "0:set=invert_camera_y=true,0f:rsu:30f", "shot": "cam-up-inverted", "expect": ["camera.angles[0] - prev.camera.angles[0] < -0.2"]},
    {"press": "0:set=invert_camera_y=false,0f:wait:10f"},
    {"press": "0:set=fov=150,0f:wait:30f", "shot": "fov-150", "expect": ["view.fov[1] > view.fov[0] + 5"]},
    {"press": "0:set=fov=100,0:set=fog_distance=400,0:set=draw_distance=400,0f:wait:30f", "shot": "far-view", "expect": ["view.far[1] == 4 * view.far[0]", "abs(view.fog[1] / view.fog[0] - 4) < 0.01", "abs(view.fov[1] - view.fov[0]) < 0.01"]},
    {"press": "0:set=fog_distance=100,0:set=draw_distance=100,0f:wait:20f", "shot": "game-view", "expect": ["view.far[1] == view.far[0]", "abs(view.fog[1] / view.fog[0] - 1) < 0.001"]},
    {"press": "0:warp=5.12,10f:wait:20f"},
    {"until": "room == 12 and player.active and not loading and not cutscene", "timeout": 30, "poll_by": [["cutscene", "0:start,45f:wait"], ["menu", "0:b,30f:wait"]]},
    {"press": "0f:wait:30f", "shot": "knights", "expect": ["len(enemies) > 0"]},
    {"press": "0:fight:15000", "shot": "fight-1"},
    {"press": "0:heal,0:fight:15000", "shot": "fight-2", "expect": ["any(int(l.split(', ')[1].split(' / ')[0]) > 0 for l in found(runlog, r'^rumble \\d+: port 1'))", "any(int(l.split(' / ')[1].split()[0]) > 0 for l in found(runlog, r'^rumble \\d+: port 1'))"]},
    {"press": "0:set=fov=100,0:set=fog_distance=400,0:set=draw_distance=400,0:warp=5.7,10f:wait:20f"},
    {"until": "room == 7 and player.active and not loading", "timeout": 40},
    {"press": "0f:wait:60f", "shot": "rampart-sky", "expect": ["view.far[1] == 4 * view.far[0]", "wide.sky.fogged > 0"]}
  ]
}
