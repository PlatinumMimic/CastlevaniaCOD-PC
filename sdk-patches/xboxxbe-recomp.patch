+// Copies of a release often have their certificate's title name, allowed media and region patched (for a hard disk
+// loader, or for any region's console), the signed sections left alone. Put back as this release has them, such a
+// copy is this release, and the game runs that: true with the xbe restored.
+bool RestoreCertificate(std::vector<uint8_t>& xbe) {
+    if (xbe.size() < 0x11C) return false;
+    uint32_t base, cert;
+    memcpy(&base, &xbe[0x104], 4);
+    memcpy(&cert, &xbe[0x118], 4);
+    if (cert < base || uint64_t(cert - base) + 0xA8 > xbe.size()) return false;
+    std::vector<uint8_t> copy = xbe;
+    memcpy(&copy[cert - base + 0x0C], kImageCertificate, 80);
+    memcpy(&copy[cert - base + 0x9C], kImageCertificate + 80, 12);
+    if (Sha1(copy) != kImageSha1) return false;
+    xbe = std::move(copy);
+    return true;
+}
