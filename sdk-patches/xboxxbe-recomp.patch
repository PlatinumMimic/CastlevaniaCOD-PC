+    if(XBE_DXC)
+        add_dependencies(${target} xbe_rt_shaders)
+        target_include_directories(${target} PRIVATE ${XBE_RT_GEN})
+        target_compile_definitions(${target} PRIVATE XBE_RAYTRACING=1)
+    endif()
+    target_link_libraries(${target} PRIVATE tomlplusplus::tomlplusplus $<LINK_ONLY:SDL3::SDL3-static> d3d12 dxgi dxguid d3dcompiler xaudio2 ole32 windowscodecs dbghelp winmm dwmapi ws2_32 wintrust)
