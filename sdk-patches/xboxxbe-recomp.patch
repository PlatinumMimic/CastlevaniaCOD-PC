+void D3D12Backend::RenderUiHdr(D3D12_CPU_DESCRIPTOR_HANDLE rh) {
+    std::lock_guard lock(app::UiLock());
+    ImGui_ImplDX12_NewFrame();
+    ImGui_ImplWin32_NewFrame();
