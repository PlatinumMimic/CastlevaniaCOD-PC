+set_source_files_properties(${XBE_SDK_DIR}/runtime/gpu/framegen.cpp PROPERTIES INCLUDE_DIRECTORIES
+    "${XBE_SDK_DIR}/third_party/fidelityfx;${XBE_SDK_DIR}/third_party/streamline/include")
 
