+using PFun_ResourceAllocateCallback = Resource(const ResourceAllocationDesc* desc, void* device);
+using PFun_ResourceReleaseCallback = void(Resource* resource, void* device);
+
+//! Log type
+enum class LogType : uint32_t
+{
