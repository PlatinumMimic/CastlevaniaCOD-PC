+    # and its certificate's title name, allowed media, region and ratings, which copies of the release often have
+    # patched: the executable puts these back to tell such a copy is this release (runtime/app/game_files.cpp)
+    xbe_u32(${xbe_file} 260 xbe_base)  # 0x104 image base
+    xbe_u32(${xbe_file} 280 xbe_cert)  # 0x118 certificate
+    math(EXPR xbe_cert "${xbe_cert} - ${xbe_base}")
+    math(EXPR xbe_title "${xbe_cert} + 12")    # +0x0C title name, 80 bytes
+    math(EXPR xbe_media "${xbe_cert} + 156")   # +0x9C allowed media, region, ratings
+    file(READ ${xbe_file} xbe_title OFFSET ${xbe_title} LIMIT 80 HEX)
+    file(READ ${xbe_file} xbe_media OFFSET ${xbe_media} LIMIT 12 HEX)
+    string(REGEX REPLACE "(..)" "0x\\1," xbe_cert_bytes "${xbe_title}${xbe_media}")
