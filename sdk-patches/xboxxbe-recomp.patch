+/// An inclusive floating-point interval [min, max].
+/// Valid instances must satisfy min <= max.
+typedef struct FfxApiFloatBounds
+{
+    float min; ///< Lower bound of the interval.
+    float max; ///< Upper bound of the interval.
+} FfxApiFloatBounds;
