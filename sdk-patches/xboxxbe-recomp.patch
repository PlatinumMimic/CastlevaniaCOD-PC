+    out.resize(size_t(d.width) * d.height);
+    for (uint32_t y = 0; y < d.height; y++) {
+        uint32_t row = Deposit(y, my);
+        for (uint32_t x = 0; x < d.width; x++) out[size_t(y) * d.width + x] = guest[row | Deposit(x, mx)];
+    }
+    return true;
+}
