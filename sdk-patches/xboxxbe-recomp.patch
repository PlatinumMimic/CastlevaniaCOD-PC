 file(GLOB XBE_RUNTIME_SOURCES CONFIGURE_DEPENDS ${XBE_SDK_DIR}/runtime/*/*.cpp)
+
+# ray tracing's shaders (runtime/gpu/rt_*.hlsl, gpu/raytrace.h): DXIL passes with inline ray queries, each a full
+# screen triangle's vertex shader (vs) and a pixel shader (ps), made into headers (k_<name>_vs, k_<name>_ps) by the
+# Windows SDK's dxc, which signs them with its dxil.dll. Without dxc the runtime builds without ray tracing
+# (XBE_RAYTRACING 0) and keeps its screen space passes
+file(GLOB XBE_RT_KITS "C:/Program Files (x86)/Windows Kits/10/bin/10.*/x64")
+list(SORT XBE_RT_KITS COMPARE NATURAL ORDER DESCENDING)
+find_program(XBE_DXC dxc HINTS "$ENV{WindowsSdkVerBinPath}x64" ${XBE_RT_KITS} NO_DEFAULT_PATH)
+set(XBE_RT_GEN ${CMAKE_BINARY_DIR}/xbe_rt)
+set(XBE_RT_HEADERS)
+if(XBE_DXC)
+    file(GLOB XBE_RT_HLSL CONFIGURE_DEPENDS ${XBE_SDK_DIR}/runtime/gpu/rt_*.hlsl)
+    file(GLOB XBE_RT_HLSLI CONFIGURE_DEPENDS ${XBE_SDK_DIR}/runtime/gpu/rt_*.hlsli)
+    foreach(hlsl ${XBE_RT_HLSL})
+        get_filename_component(name ${hlsl} NAME_WE)
+        foreach(stage vs ps)
+            add_custom_command(OUTPUT ${XBE_RT_GEN}/${name}_${stage}.h
+                COMMAND ${CMAKE_COMMAND} -E make_directory ${XBE_RT_GEN}
+                COMMAND ${XBE_DXC} -nologo -T ${stage}_6_5 -E ${stage} -O3 -Vn k_${name}_${stage}
+                        -Fh ${XBE_RT_GEN}/${name}_${stage}.h ${hlsl}
+                DEPENDS ${hlsl} ${XBE_RT_HLSLI} VERBATIM)
+            list(APPEND XBE_RT_HEADERS ${XBE_RT_GEN}/${name}_${stage}.h)
+        endforeach()
+    endforeach()
+    add_custom_target(xbe_rt_shaders DEPENDS ${XBE_RT_HEADERS})
+    message(STATUS "XbeRecomp: ray tracing's shaders by ${XBE_DXC}")
+else()
+    message(STATUS "XbeRecomp: no dxc found, the runtime builds without ray tracing")
+endif()
