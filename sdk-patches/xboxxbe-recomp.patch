+void D3D12Backend::KeepMotionConstants(uint64_t key, const uint8_t* vsc) {
+    mv_now_at_[key].push_back(uint32_t(mv_now_.size()));
+    mv_now_.emplace_back();
+    std::memcpy(mv_now_.back().c, vsc, sizeof(MotionConstants::c));
+}
