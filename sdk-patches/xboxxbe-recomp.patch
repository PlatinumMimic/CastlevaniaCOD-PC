+inline sl::Result slPCLSetMarker(sl::PCLMarker marker, const sl::FrameToken& frame)
+{
+    SL_FEATURE_FUN_IMPORT_STATIC(sl::kFeaturePCL, slPCLSetMarker);
+    return s_slPCLSetMarker(marker, frame);
+}
