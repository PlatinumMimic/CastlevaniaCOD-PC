+// an interface pointer's IID and address, for a creating call
+template <typename T>
+void** IID_PPV_ARGS_Helper(T** pp) {
+    return reinterpret_cast<void**>(pp);
+}
+#define IID_PPV_ARGS(pp) __uuidof(**(pp)), IID_PPV_ARGS_Helper(pp)
