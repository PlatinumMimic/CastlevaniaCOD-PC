+
+# A game's releases (each region's xbe, recompiled into its executable by add_xbe_image) for GameInfo::releases: writes
+# <file> with kReleases[kReleaseCount], each an xbe's SHA-1, its certificate's bytes and its executable's name, to
+# link into those executables, and into a launcher that tells them apart
+function(xbe_releases file)
+    set(certificates "")
+    set(list "")
+    set(i 0)
+    foreach(target ${ARGN})
+        get_target_property(sha ${target} XBE_SHA1)
+        get_target_property(certificate ${target} XBE_CERTIFICATE)
+        string(APPEND certificates "const unsigned char kCertificate${i}[92] = {${certificate}};\n")
+        string(APPEND list "    {\"${sha}\", kCertificate${i}, \"${target}\"},\n")
+        math(EXPR i "${i} + 1")
+    endforeach()
+    file(CONFIGURE OUTPUT ${file} CONTENT "// the game's releases, written by CMake (xbe_releases)
+#include \"app/app.h\"
+
+namespace {
+${certificates}}  // namespace
+
+extern const app::GameInfo::Release kReleases[] = {
+${list}};
+extern const unsigned kReleaseCount = ${i};
+")
+endfunction()
diff --git a/cmake/xbe_hooks.cmake b/cmake/xbe_hooks.cmake
new file mode 100644
index 0000000..a683533
--- /dev/null
+++ b/cmake/xbe_hooks.cmake
@@ -0,0 +1,24 @@
+# Linux: the functions an executable overrides, from its exported names, and the game code library's version script
+# with them. Global in the library, a name binds to the executable's as the library is loaded; every other one is
+# local, so the library calls its own bodies directly. A release ships the list beside its compiler (HOOKS), which the
+# first start's link reads (runtime/app/game_code.cpp writes the same script).
+#   cmake -DNM=<nm> -DEXE=<executable> -DHOOKS=<list out> -DMAP=<version script out> -P xbe_hooks.cmake
+execute_process(COMMAND ${NM} -D --defined-only ${EXE} OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
+if(NOT result EQUAL 0)
+    message(FATAL_ERROR "${NM} could not read ${EXE}")
+endif()
+string(REGEX MATCHALL "[ \t]T[ \t]+sub_[0-9A-F]+" lines "${symbols}")
+set(hooks "")
+foreach(line ${lines})
+    string(REGEX REPLACE ".*(sub_[0-9A-F]+)" "\\1" name "${line}")
+    string(APPEND hooks "${name}\n")
+endforeach()
+file(WRITE ${HOOKS}.tmp "${hooks}")
+file(COPY_FILE ${HOOKS}.tmp ${HOOKS} ONLY_IF_DIFFERENT)
+file(REMOVE ${HOOKS}.tmp)
+
+string(REPLACE "\n" ";\n    " globals "${hooks}")
+set(map "{\n  global:\n    X86FuncMappings; X86Continuations; X86CodeBase; X86CodeEnd; X86ImageBase; X86ImageEnd;\n")
+string(APPEND map "    X86EntryPoint; X86KernelThunk; __imp__sub_*;\n    ${globals}\n  local: *;\n};\n")
+string(REPLACE "    \n" "" map "${map}")
+file(WRITE ${MAP} "${map}")  # written each time: the build's step for it is done once it is newer than the executable
