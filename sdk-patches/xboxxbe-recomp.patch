diff --git a/runtime/linux/wrl/client.h b/runtime/linux/wrl/client.h
new file mode 100644
index 0000000..261019d
--- /dev/null
+++ b/runtime/linux/wrl/client.h
@@ -0,0 +1,105 @@
+#pragma once
+// Linux: Microsoft::WRL::ComPtr, as much of it as the shared sources use, over vkd3d's COM objects
+#include <cstddef>
+#include <memory>
+#include <utility>
+
+#include "../d3d12.h"
+
+namespace Microsoft::WRL {
+
+template <typename T>
+class ComPtr;
+
+// what &ptr gives, as WRL's: the object's address for an out parameter (let go first), or the ComPtr's own
+template <typename T>
+class ComPtrRef {
+public:
+    explicit ComPtrRef(ComPtr<T>* p) : p_(p) {}
+    operator T**() { return p_->ReleaseAndGetAddressOf(); }
+    operator void**() { return reinterpret_cast<void**>(p_->ReleaseAndGetAddressOf()); }
+    operator ComPtr<T>*() { return p_; }
+    T* operator*() { return p_->Get(); }
+
+private:
+    ComPtr<T>* p_;
+};
+
+template <typename T>
+class ComPtr {
+public:
+    ComPtr() = default;
+    ComPtr(std::nullptr_t) {}
+    ComPtr(T* p) : p_(p) { AddRef(); }
+    ComPtr(const ComPtr& o) : p_(o.p_) { AddRef(); }
+    ComPtr(ComPtr&& o) noexcept : p_(std::exchange(o.p_, nullptr)) {}
+    ~ComPtr() { Release(); }
+    ComPtr& operator=(const ComPtr& o) {
+        if (p_ != o.p_) {
+            Release();
+            p_ = o.p_;
+            AddRef();
+        }
+        return *this;
+    }
+    ComPtr& operator=(ComPtr&& o) noexcept {
+        if (this != std::addressof(o)) {
+            Release();
+            p_ = std::exchange(o.p_, nullptr);
+        }
+        return *this;
+    }
+    ComPtr& operator=(T* p) {
+        if (p_ != p) {
+            Release();
+            p_ = p;
+            AddRef();
+        }
+        return *this;
+    }
+    ComPtr& operator=(std::nullptr_t) {
+        Release();
+        return *this;
+    }
+
+    T* Get() const { return p_; }
+    T* operator->() const { return p_; }
+    explicit operator bool() const { return p_ != nullptr; }
+    // as WRL's: the old object is let go first, for an out parameter
+    ComPtrRef<T> operator&() { return ComPtrRef<T>(this); }
+    T** GetAddressOf() { return &p_; }
+    T* const* GetAddressOf() const { return &p_; }
+    T** ReleaseAndGetAddressOf() {
+        Release();
+        return &p_;
+    }
+    void Reset() { Release(); }
+    void Attach(T* p) {
+        Release();
+        p_ = p;
+    }
+    T* Detach() { return std::exchange(p_, nullptr); }
+    template <typename U>
+    HRESULT As(ComPtr<U>* out) const {
+        return p_ ? p_->QueryInterface(__uuidof(U), reinterpret_cast<void**>(out->ReleaseAndGetAddressOf())) : E_POINTER;
+    }
+    friend bool operator==(const ComPtr& a, std::nullptr_t) { return a.p_ == nullptr; }
+    friend bool operator!=(const ComPtr& a, std::nullptr_t) { return a.p_ != nullptr; }
+
+private:
+    void AddRef() {
+        if (p_) p_->AddRef();
+    }
+    void Release() {
+        if (T* p = std::exchange(p_, nullptr)) p->Release();
+    }
+    T* p_ = nullptr;
+};
+
+}  // namespace Microsoft::WRL
+
+template <typename T>
+void** IID_PPV_ARGS_Helper(Microsoft::WRL::ComPtrRef<T> pp) {
+    return pp;
+}
+
