+#pragma once
+// Ray tracing over a title's own 3D (DXR 1.1 inline ray queries): each frame, the triangles its world's draws put on
+// the screen are gathered into an acceleration structure, which passes after the frame's 3D trace rays through.
+//
+// The scene: a world draw into the frame (the extension's Jitter: the frame's 3D), opaque and writing depth, has its
+// vertex shader also store each vertex as it is drawn (anti-aliasing's offset and all) into the frame's capture buffer:
+// its clip x, y and w, its z, its first texture coordinates, its colour and its index (kRtCapture in shaders.cpp).
+// Every program and fixed function draw alike, so characters skinned in their programs are where they are drawn.
+// The draws' index buffers (strips made lists) give its triangles; the clip x, y and w are view space but for the
+// view's scale across and down, which the scene's one instance puts back. Everything traced is in view space: x
+// right, y up, z ahead, as the screen space passes find it from depth.
+//
+// Its shaders are DXIL, compiled when the runtime is built by the Windows SDK's dxc (rt_*.hlsl, XBE_RAYTRACING);
+// without dxc, or on a card without DXR 1.1, there is no ray tracing and the screen space passes stay.
+//
+// The passes (rt_*.hlsl, rt_scene.hlsli for what a hit is): ambient occlusion (rt_ao.hlsl) and reflections
+// (rt_refl.hlsl), each a pixel shader over the frame's 3D before its anti-aliasing. Each draw's Look (its picture, a
+// texture pack material's maps and gloss) shades a hit as the game drew it. Room to grow: Lights() holds lights placed
+// in the scene (shadows, a later pass).
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#include <wrl/client.h>
+
+#include <atomic>
+#include <cstdint>
+#include <vector>
+
+namespace gpu {
+
+// what ray tracing does (the settings): bits, 1 ambient occlusion, 2 reflections, 4 bounce lighting; 0 none, the
+// screen space passes
+inline std::atomic<uint32_t> g_ray_tracing{0};
+enum : uint32_t { kRtAmbientOcclusion = 1, kRtReflections = 2, kRtLighting = 4 };
+// bounce lighting's strength, 0 to 1 and more (the settings' percent / 100)
+inline std::atomic<float> g_rt_lighting_strength{1.0f};
+// reflections' strength, 0 to 1 and more (the settings' percent / 100)
+inline std::atomic<float> g_rt_reflection_strength{1.0f};
+// the renderer can: DXR 1.1 on the graphics card, in a runtime built with its shaders
+inline std::atomic<bool> g_ray_tracing_ready{false};
+
+namespace rt {
+
+constexpr uint32_t kVertexBytes = 32;  // a captured vertex: clip x, y, w, z; u, v; colour (RGBA8); its index
+
+// how a draw looks, for what a ray meets: views in the renderer's SRV heap, which the frame's descriptor ring keeps
+// until the passes (UINT32_MAX none)
+struct Look {
+    uint32_t picture = UINT32_MAX;  // its stage 0 picture (2D)
+    uint32_t alpha = 0;             // a cut-out's alpha test: 0x10000, 0x20000 times the vertices' alpha, D3D12
+                                    // comparison - 1 << 8, reference (0: solid)
+    uint32_t orm = UINT32_MAX, normal = UINT32_MAX;  // a texture pack material's maps, over stage 0's coordinates
+    float rough_bias = 0, metal_scale = 0;           // its parameters (Material::params[2] y, z)
+    float gloss_roughness = 0, gloss_metalness = 0;  // Material::gloss
+};
+
+// a draw in the scene: its indices (a list; 0 for none, its vertices taken three by three) and its vertices' first slot
+struct Geometry {
+    D3D12_GPU_VIRTUAL_ADDRESS indices = 0;
+    DXGI_FORMAT index_format = DXGI_FORMAT_UNKNOWN;
+    uint32_t index_count = 0;
+    uint32_t first = 0, vertex_count = 0;
+    uint32_t index_start = UINT32_MAX;  // its first index in the frame's index buffer, UINT32_MAX for none
+    Look look;
+};
+
+// What a ray's hit is, for the shaders (rt_scene.hlsli): the frame's captured vertices (kVertexBytes each), its
+// indices (32 bit) and, for each draw in the scene in its order (a hit's geometry index), its first vertex slot, first
+// index (0xFFFFFFFF: its vertices three by three) and its Look. A hit's triangle k of draw g is then its three
+// vertices, and a cut-out's triangle is solid where its picture passes the draw's alpha test (the scene's other draws
+// are opaque).
+struct GeometryEntry {
+    uint32_t first, index_start, picture, alpha;
+    uint32_t orm, normal;
+    float rough_bias, metal_scale;
+    float gloss_roughness, gloss_metalness, pad[2];
+};
+
+// a light placed in the scene, for passes to come (view space at the frame's draw, colour in linear units)
+struct Light {
+    float position[3];
+    float radius;
+    float color[3];
+    float pad;
+};
+
+class Scene {
+public:
+    // false when the device can't: no DXR 1.1, or a runtime built without its shaders
+    bool Init(ID3D12Device* dev, ID3D12GraphicsCommandList* cl, uint32_t frames);
+    bool Ready() const { return ready_; }
+    // the frame's start, on its slot (its last use done): its capture buffer to the vertex shaders
+    void Begin(uint32_t slot);
+    // the capture buffer the vertex shaders write (u0), the frame's
+    D3D12_GPU_VIRTUAL_ADDRESS Capture() const;
+    // room for n vertices: their first slot, UINT32_MAX when the frame's buffer has none (the next frame's is larger)
+    uint32_t Reserve(uint32_t n);
+    // a draw whose vertex shader wrote its vertices from slot first: its triangles from the title's indices (16 or 32
+    // bit, null for none: its vertices in order), a list or a strip, copied into the scene's own (the renderer's
+    // upload ring may start again within the frame); how it looks
+    void AddDraw(const void* indices, uint32_t index_count, bool index16, bool strip, uint32_t draw_count, uint32_t first,
+                 uint32_t slots, const Look& look = {});
+    uint32_t Draws() const { return uint32_t(geoms_.size()); }
+    // the frame's draws as an acceleration structure; to_view: the instance's 3x4 transform, row major. False
+    // without any
+    bool Build(const float to_view[12]);
+    bool Built() const { return built_; }
+    D3D12_GPU_VIRTUAL_ADDRESS Tlas() const;
+    // the scene's vertices, indices and draws (GeometryEntry), once built: what a hit is
+    D3D12_GPU_VIRTUAL_ADDRESS Vertices() const;
+    D3D12_GPU_VIRTUAL_ADDRESS Indices() const;
+    D3D12_GPU_VIRTUAL_ADDRESS GeometryTable() const;
+    std::vector<Light>& Lights() { return lights_; }
+
+    // The passes, each a full screen triangle's pixel shader into a w x h part of a render target (rtv, of format fmt)
+    // from its top left: ambient occlusion (rt_ao.hlsl) into its R8 target; reflections (rt_refl.hlsl) over the frame's
+    // 3D, premultiplied; bounce lighting (rt_gi.hlsl) into its RGBA16F target, and its smoothing (rt_giapply.hlsl)
+    // added over the frame's 3D; the guides (rt_guide.hlsl) into four targets, the surfaces' albedo (RGBA8), their
+    // world normals and roughness (RGBA16F), their specular albedo (RGBA8) and the reflections' hit distance (R16F, 0
+    // there, written by the reflections where they trace: their second target). The targets after the first are more
+    // (n_more of them, kept apart from the first's blending). cb is the pass's P, depth the depth's table (one SRV),
+    // pictures the renderer's SRV heap's start (the draws' pictures by their Look, and any texture a pass is told the
+    // index of). False when its pipeline was not made for those formats
+    enum class Pass { AmbientOcclusion, Reflections, Bounce, BounceApply, Guides };
+    struct Out {
+        D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+        DXGI_FORMAT fmt;
+    };
+    static constexpr uint32_t kMaxOut = 4;
+    bool Trace(Pass pass, D3D12_GPU_VIRTUAL_ADDRESS cb, D3D12_GPU_DESCRIPTOR_HANDLE depth,
+               D3D12_GPU_DESCRIPTOR_HANDLE pictures, D3D12_CPU_DESCRIPTOR_HANDLE rtv, DXGI_FORMAT fmt, uint32_t w,
+               uint32_t h, const Out* more = nullptr, uint32_t n_more = 0);
+
+private:
+    struct Slot {
+        Microsoft::WRL::ComPtr<ID3D12Resource> capture, blas, tlas, scratch, instance, indices, table;
+        uint64_t capture_bytes = 0, blas_bytes = 0, tlas_bytes = 0, scratch_bytes = 0, index_bytes = 0, table_bytes = 0;
+        uint32_t* index_map = nullptr;
+        GeometryEntry* table_map = nullptr;
+        D3D12_RESOURCE_STATES capture_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        void* instance_map = nullptr;
+    };
+    bool Ensure(Microsoft::WRL::ComPtr<ID3D12Resource>& r, uint64_t& have, uint64_t want, D3D12_RESOURCE_STATES state);
+    bool EnsureIndices(Slot& s, uint64_t count);
+    bool EnsureTable(Slot& s, uint64_t count);
+    void Add(const Geometry& g);
+    void UavBarrier();
+
+    Microsoft::WRL::ComPtr<ID3D12Device5> dev_;
+    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList4> cl_;
+    ID3D12PipelineState* Pipeline(Pass pass, const DXGI_FORMAT* fmts, uint32_t n);
+    Microsoft::WRL::ComPtr<ID3D12RootSignature> ao_root_;  // every pass's
+    struct Made {
+        Pass pass;
+        uint32_t n;
+        DXGI_FORMAT fmt[kMaxOut];
+        Microsoft::WRL::ComPtr<ID3D12PipelineState> pso;  // null: tried, not made
+    };
+    std::vector<Made> psos_;
+    std::vector<Slot> slots_;
+    uint32_t slot_ = 0;
+    bool ready_ = false, built_ = false;
+    uint64_t builds_ = 0;
+    uint32_t used_ = 0, want_ = 0;  // vertices this frame, and the most a frame asked for
+    uint64_t index_used_ = 0, index_want_ = 0;  // indices likewise
+    std::vector<Geometry> geoms_;
+    std::vector<D3D12_RAYTRACING_GEOMETRY_DESC> descs_;
+    std::vector<Light> lights_;
+};
+
+}  // namespace rt
+}  // namespace gpu
diff --git a/runtime/gpu/rt_ao.hlsl b/runtime/gpu/rt_ao.hlsl
new file mode 100644
index 0000000..f6f3590
--- /dev/null
+++ b/runtime/gpu/rt_ao.hlsl
@@ -0,0 +1,119 @@
+// Ray traced ambient occlusion (raytrace.cpp, DXR 1.1 inline ray queries, shader model 6.5, compiled to DXIL when the
+// runtime is built): each pixel of the frame's 3D, found again in view space from its depth as the screen space pass
+// finds it (kAoHlsl in d3d12.cpp), sends a few rays over the hemisphere above its surface into the frame's scene (the
+// world's draws as drawn, raytrace.h), and is as dark as what they meet within the radius, the nearer the darker.
+// What the screen does not show still shades: the underside of a ledge, a pillar beside the frame's edge. The
+// anti-aliasing's pass after it gathers its noise over the frames, as it does the screen space pass's. Drawn as a
+// pixel shader into the ambient occlusion's target, as that pass is, so the frame's pictures (a cut-out's, which the
+// rays see through where it is see-through) are read as the draws read them.
+//
+// Where each pixel is comes from a ray from the eye through it into the scene, its surface's slope from the triangle
+// it meets (exact at every edge, where the depth's neighbours are not), unless the depth holds something nearer that
+// the scene does not: then from the depth. A ray that meets the scene farther than the depth has slipped through a
+// crack between two of its meshes (rays half a pixel aside meet the surface at the depth: its place is the depth's) or
+// the depth is from something that is not in the scene (a screen space panel: looked through).
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), the ambient occlusion's (aw, ah)
+    float4 ao;    // radius in view units, strength, distance where it has faded out, rays a pixel
+    float4 fr;    // the frame's number, XBE_RT_VIEW, the rays' start off the surface: a constant and a part of the depth
+};
+#include "rt_scene.hlsli"
+Texture2D<float> depth : register(t1);
+
+// the buffer holds a + b / z: 1 / z runs straight from 1 / cam.x at 0 to 1 / cam.y at 1
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float Depth(int2 px) { return depth.Load(int3(clamp(px, int2(0, 0), int2(part.xy) - 1), 0)); }
+// a depth texel's centre in view space: x right, y up, z ahead
+float3 ViewPos(int2 px, float d) {
+    float2 uv = (float2(px) + 0.5) / part.xy;
+    float z = ViewZ(d);
+    return float3((uv.x * 2 - 1) * cam.z * z, (1 - uv.y * 2) * cam.w * z, z);
+}
+// a number from 0 to 1 for a pixel, a ray and a frame, different for each
+float Hash(uint3 v) {
+    v = v * 1664525u + 1013904223u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    v ^= v >> 16u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    return float(v.x & 0xFFFFFF) / 16777216.0f;
+}
+// the scene's surface along d from the eye between tmin and tmax: its distance (-1 for none) and its normal
+float Primary(float3 d, float tmin, float tmax, out float3 n) {
+    uint geom, prim;
+    float t = TraceScene(0, d, tmin, tmax, 32, geom, prim);
+    n = t >= 0 ? FaceNormal(geom, prim, d) : 0;
+    return t;
+}
+
+float ps(float4 pos : SV_Position) : SV_Target {
+    uint2 id = uint2(pos.xy);
+    // its depth texel
+    int2 px = int2((float2(id) + 0.5) * part.xy / part.zw);
+    float d = Depth(px);
+    float3 p = ViewPos(px, d);
+    if (p.z >= 0.999 * max(cam.x, cam.y)) return fr.y == 1 ? 0.25f : 1.0f;  // nothing drawn there: the far plane
+    // the surface: the scene's, met from the eye
+    float len = length(p);
+    float3 dir = p / len, n;
+    float t = Primary(dir, 0, 1e30f, n);
+    // XBE_RT_VIEW 1: whether the scene is where the frame drew it: a ray from the eye through the pixel meets it
+    // within 2% of the depth (white), farther or nearer (grey: the depth from something not in the scene), or not at
+    // all (black). 2: the surface's slope as used (the share of it facing up, 0.5 level). 3, 4: below
+    if (fr.y == 1) return t < 0 ? 0.0f : abs(t - len) < 0.02f * len ? 1.0f : 0.5f;
+    bool met = t >= 0 && t > 0.98f * len && any(n != 0), crack = false;
+    if (met && t > 1.02f * len) {
+        float2 uv = (float2(px) + 0.5f) / part.xy;
+        float2 off[4] = {float2(0.5f, 0), float2(-0.5f, 0), float2(0, 0.5f), float2(0, -0.5f)};
+        [unroll] for (int k = 0; k < 4 && !crack; k++) {
+            float2 u = uv + off[k] / part.xy;
+            float3 d2 = normalize(float3((u.x * 2 - 1) * cam.z, (1 - u.y * 2) * cam.w, 1));
+            float3 n2;
+            float l2 = p.z / max(d2.z, 1e-4f);  // about the depth's distance that way
+            crack = Primary(d2, 0.95f * l2, 1.05f * l2, n2) >= 0 && any(n2 != 0);
+            if (crack) n = n2;
+        }
+    }
+    if (met && !crack) {
+        p = dir * t;
+    } else if (!crack) {
+        // the depth's: the surface's slope from the nearer neighbour each way, so an edge doesn't bend it
+        float3 pr = ViewPos(px + int2(1, 0), Depth(px + int2(1, 0))) - p, pl = p - ViewPos(px - int2(1, 0), Depth(px - int2(1, 0)));
+        float3 pd = ViewPos(px + int2(0, 1), Depth(px + int2(0, 1))) - p, pu = p - ViewPos(px - int2(0, 1), Depth(px - int2(0, 1)));
+        float3 dx = abs(pr.z) < abs(pl.z) ? pr : pl, dy = abs(pd.z) < abs(pu.z) ? pd : pu;
+        n = normalize(cross(dx, dy));
+        if (dot(n, p) > 0) n = -n;  // facing the eye
+    }
+    if (fr.y == 2) return 0.5f + 0.5f * n.y;
+    // 3: where the place came from: the scene (white), the depth at a crack (light grey), the depth for a nearer hit
+    // (grey), the depth for none (black)
+    if (fr.y == 3) return crack ? 0.75f : met ? 1.0f : t >= 0 ? 0.5f : 0.0f;
+    if (p.z >= ao.z) return 1;
+    // a frame around the normal
+    float3 t0 = normalize(abs(n.y) < 0.99f ? cross(n, float3(0, 1, 0)) : cross(n, float3(1, 0, 0)));
+    float3 b0 = cross(n, t0);
+    // off the surface by a little more the farther it is: the depth buffer's own steps, and clear of the thin sheets
+    // this title's rooms lay a few units over their floors (a rim's edge, a panel's border), which would otherwise
+    // shut a pixel's every ray into a black seam
+    float3 o = p + n * (fr.z + fr.w * p.z);
+    int rays = int(ao.w);
+    float hidden = 0, nearest = ao.x;
+    [loop] for (int k = 0; k < rays; k++) {
+        // cosine weighted over the hemisphere: more rays near the normal, as light falls
+        float u1 = Hash(uint3(id, uint(fr.x) * 16u + uint(k)));
+        float u2 = Hash(uint3(id.yx + 7919u, uint(fr.x) * 16u + uint(k) + 1013u));
+        float r = sqrt(u1), a = 6.2831853f * u2;
+        float3 rd = t0 * (r * cos(a)) + b0 * (r * sin(a)) + n * sqrt(max(0, 1 - u1));
+        // what it meets hides less the farther it is: none at the radius, as the screen space pass weighs it
+        float th = TraceScene(o, rd, 0, ao.x, 8);
+        if (th >= 0) {
+            hidden += saturate(1 - th * th / (ao.x * ao.x));
+            nearest = min(nearest, th);
+        }
+    }
+    // 4: how near the nearest thing a ray met is, in 32 units (black: touching)
+    if (fr.y == 4) return saturate(nearest / 32);
+    float vis = saturate(1 - ao.y * hidden / float(max(rays, 1)));
+    // faded out with distance: the far half of its reach
+    return lerp(vis, 1, saturate((p.z - 0.5f * ao.z) / (0.5f * ao.z)));
+}
diff --git a/runtime/gpu/rt_gi.hlsl b/runtime/gpu/rt_gi.hlsl
new file mode 100644
index 0000000..a5e9374
--- /dev/null
+++ b/runtime/gpu/rt_gi.hlsl
@@ -0,0 +1,81 @@
+// Ray traced bounce lighting (raytrace.cpp, DXR 1.1 inline ray queries, compiled to DXIL when the runtime is built):
+// the light the room's own surfaces throw onto each other. Each pixel of the frame's 3D, at a part of its size, finds
+// its surface in the frame's scene (as ambient occlusion does, rt_ao.hlsl) and sends a few rays over the hemisphere
+// above it; each ray that meets something takes on that thing's colour as the game drew it (its picture times its
+// vertices' colour, which holds the game's light), and their mean is the light arriving from around: water's blue on
+// the stone beside it, a torchlit wall's warmth on the floor before it, a red carpet's on the pillar it touches. It goes
+// into the bounce target (RGB) as it arrives, without the surface's own colour, which rt_giapply.hlsl smooths and then
+// multiplies by the surface's colour at the frame's full size (rt_guide.hlsl), so the stone's carving stays sharp in
+// it, and adds into the frame, before the anti-aliasing gathers what noise is left over the frames.
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), the bounce target's part (gw, gh)
+    float4 gi;    // the farthest a ray reaches, rays a pixel, strength, the distance where it has faded out
+    float4 fr;    // the frame's number, XBE_RT_VIEW, the rays' start off the surface: a constant and a part of the depth
+};
+#include "rt_scene.hlsli"
+Texture2D<float> depth : register(t1);
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float Depth(int2 px) { return depth.Load(int3(clamp(px, int2(0, 0), int2(part.xy) - 1), 0)); }
+float3 ViewPos(int2 px, float d) {
+    float2 uv = (float2(px) + 0.5) / part.xy;
+    float z = ViewZ(d);
+    return float3((uv.x * 2 - 1) * cam.z * z, (1 - uv.y * 2) * cam.w * z, z);
+}
+float Hash(uint3 v) {
+    v = v * 1664525u + 1013904223u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    v ^= v >> 16u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    return float(v.x & 0xFFFFFF) / 16777216.0f;
+}
+// a draw's picture at a point of one of its triangles, as blurred as a footprint this wide (white without a picture)
+float3 PictureAt(uint geom, Spot s, float footprint) {
+    uint pic = geo[geom].a.z;
+    if (pic == kNone) return 1;
+    Texture2D<float4> t = pictures[NonUniformResourceIndex(pic)];
+    return t.SampleLevel(wrap, s.at, LevelOf(t, s, footprint)).rgb;
+}
+
+float4 ps(float4 pos : SV_Position) : SV_Target {
+    uint2 id = uint2(pos.xy);
+    // the depth texel at the middle of its part
+    int2 px = int2((float2(id) + 0.5) * part.xy / part.zw);
+    float3 p = ViewPos(px, Depth(px));
+    if (p.z >= 0.999 * max(cam.x, cam.y) || p.z >= gi.w) return 0;  // nothing drawn there, or too far
+    float len = length(p);
+    float3 dir = p / len;
+    uint geom, prim;
+    float2 bary;
+    float t = TraceScene(0, dir, 0, 1e30f, 32, geom, prim, bary);
+    if (t < 0 || abs(t - len) > 0.02f * len) return 0;  // not the scene's surface: no bounce
+    Spot s = SpotOf(geom, prim, bary);
+    float3 n = Facing(s.p[0], s.p[1], s.p[2], dir);
+    if (all(n == 0)) return 0;
+    float pixel = 2 * cam.w / part.y;
+    float3 t0 = normalize(abs(n.y) < 0.99f ? cross(n, float3(0, 1, 0)) : cross(n, float3(1, 0, 0)));
+    float3 b0 = cross(n, t0);
+    float3 o = dir * t + n * (fr.z + fr.w * t);
+    int rays = int(gi.y);
+    float3 sum = 0;
+    [loop] for (int k = 0; k < rays; k++) {
+        // cosine weighted: each ray counts as much as the light from its way does
+        float u1 = Hash(uint3(id, uint(fr.x) * 8u + uint(k)));
+        float u2 = Hash(uint3(id.yx + 7919u, uint(fr.x) * 8u + uint(k) + 1013u));
+        float r = sqrt(u1), a = 6.2831853f * u2;
+        float3 rd = t0 * (r * cos(a)) + b0 * (r * sin(a)) + n * sqrt(max(0, 1 - u1));
+        uint g2, p2;
+        float2 b2;
+        float t2 = TraceScene(o, rd, 0, gi.x, 16, g2, p2, b2);
+        if (t2 < 0) continue;  // the open sky or past the reach: none from there
+        Spot hs = SpotOf(g2, p2, b2);
+        // its colour as the game lit it, its picture read broadly (what a bounce sees is soft)
+        float3 seen = saturate(hs.tint.rgb) * PictureAt(g2, hs, (t + t2) * pixel * 8);
+        sum += seen * saturate(4 * (1 - t2 / gi.x));  // fading near the reach, so where it ends draws no line
+    }
+    float3 light = sum / float(max(rays, 1)) * gi.z;
+    // fading out with distance: the far half of its reach on screen
+    light *= saturate((gi.w - p.z) / (0.5f * gi.w));
+    return float4(light, 1);
+}
diff --git a/runtime/gpu/rt_giapply.hlsl b/runtime/gpu/rt_giapply.hlsl
new file mode 100644
index 0000000..f3603d3
--- /dev/null
+++ b/runtime/gpu/rt_giapply.hlsl
@@ -0,0 +1,50 @@
+// Ray traced bounce lighting's second step (rt_gi.hlsl): the light arriving at each surface, gathered by a few rays a
+// pixel at a part of the frame's size, smoothed across a 5x5 of its texels that lie on the same surface as the pixel
+// (by their depth and their normal, rt_guide.hlsl's), then thrown back in the surface's own colour at the frame's full
+// size (the guides' albedo: the stone's carving stays as sharp as its picture) and added into the frame's 3D. The
+// anti-aliasing after it gathers what noise is left over the frames.
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), the bounce target's part (gw, gh)
+    float4 ap;    // the SRV heap's indices of the depth and the bounce target, its step between taps, XBE_RT_VIEW
+    float4 gu;    // the SRV heap's indices of the guides' albedo and normals, unused
+};
+#include "rt_scene.hlsli"
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+
+float4 ps(float4 pos : SV_Position) : SV_Target {
+    Texture2D<float4> depth = pictures[NonUniformResourceIndex(uint(ap.x))];
+    Texture2D<float4> bounce = pictures[NonUniformResourceIndex(uint(ap.y))];
+    Texture2D<float4> albedo = pictures[NonUniformResourceIndex(uint(gu.x))];
+    Texture2D<float4> normals = pictures[NonUniformResourceIndex(uint(gu.y))];
+    int2 px = int2(pos.xy);
+    float4 a = albedo.Load(int3(px, 0));
+    if (a.a == 0) return 0;  // not the scene's surface: as the game drew it
+    float zc = ViewZ(depth.Load(int3(px, 0)).r);
+    float3 nc = normals.Load(int3(px, 0)).xyz;  // in the world: only their angle to each other counts here
+    // the pixel's place in the bounce target
+    float2 g = (float2(px) + 0.5) * part.zw / part.xy - 0.5;
+    int2 g0 = int2(floor(g));
+    float3 sum = 0;
+    float wsum = 0;
+    [unroll] for (int y = -2; y <= 2; y++) {
+        [unroll] for (int x = -2; x <= 2; x++) {
+            int2 q = clamp(g0 + int2(x, y) * int(ap.z), int2(0, 0), int2(part.zw) - 1);
+            // the tap's surface where the bounce pass found it (its texel's middle)
+            int2 dp = int2((float2(q) + 0.5) * part.xy / part.zw);
+            float z = ViewZ(depth.Load(int3(dp, 0)).r);
+            float3 n = normals.Load(int3(dp, 0)).xyz;
+            float2 dg = float2(q) - g;
+            float w = exp(-abs(z - zc) / (0.03f * zc)) * pow(saturate(dot(n, nc)), 8) *
+                      exp(-dot(dg, dg) / (2 * 2.5f * 2.5f * ap.z * ap.z));
+            sum += bounce.Load(int3(q, 0)).rgb * w;
+            wsum += w;
+        }
+    }
+    float3 light = sum / max(wsum, 1e-4f);
+    // XBE_RT_VIEW 8: the light arriving alone, 9: thrown back (in the frame's place)
+    if (ap.w == 8) return float4(light, 1);
+    if (ap.w == 9) return float4(light * a.rgb, 1);
+    return float4(light * a.rgb, 0);  // added
+}
diff --git a/runtime/gpu/rt_guide.hlsl b/runtime/gpu/rt_guide.hlsl
new file mode 100644
index 0000000..ebe209e
--- /dev/null
+++ b/runtime/gpu/rt_guide.hlsl
@@ -0,0 +1,101 @@
+// Ray tracing's guides (raytrace.cpp): what each pixel of the frame's 3D is, at its full size, for the passes that
+// smooth what the rays gathered and for the denoiser that takes them (DLSS Ray Reconstruction). A ray from the eye
+// through the pixel meets the scene where the frame drew it, and its draw tells the surface: its picture's colour there
+// (its albedo, without the game's light), its normal (the face's, bent by a texture pack's normal map) turned into the
+// world, its roughness (the material's, 1 without one) and its specular albedo (the share of the light a mirror
+// direction's rays bring that it gives back: a texture pack's materials only, the game's own surfaces reflect nothing).
+// Where the scene is not what the frame drew (an effect, the sky), the albedo is white with alpha 0 (the passes leave
+// the pixel as the game drew it, and the denoiser takes its colour as light). The fourth target, the reflections' hit
+// distance, is 0 here and written by rt_refl.hlsl where it traces.
+cbuffer P : register(b0) {
+    float4 cam;    // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;   // the 3D's size in depth texels (rw, rh), unused
+    float4 right;  // the view's x (right), y (up) and z (ahead) in the world
+    float4 up;
+    float4 ahead;
+};
+#include "rt_scene.hlsli"
+Texture2D<float> depth : register(t1);
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float3 ViewPos(int2 px, float d) {
+    float2 uv = (float2(px) + 0.5) / part.xy;
+    float z = ViewZ(d);
+    return float3((uv.x * 2 - 1) * cam.z * z, (1 - uv.y * 2) * cam.w * z, z);
+}
+// the split sum's share of a mirror's light a surface gives back (Karis's fit), none at a reflectance of 0
+float3 SpecularAlbedo(float3 f0, float rough, float nv) {
+    const float4 c0 = float4(-1, -0.0275f, -0.572f, 0.022f);
+    const float4 c1 = float4(1, 0.0425f, 1.04f, -0.04f);
+    float4 r = rough * c0 + c1;
+    float a004 = min(r.x * r.x, exp2(-9.28f * nv)) * r.x + r.y;
+    float2 ab = float2(-1.04f, 1.04f) * a004 + r.zw;
+    ab.y *= saturate(50 * f0.g);
+    return saturate(f0 * ab.x + ab.y);
+}
+float3 ToWorld(float3 n) { return normalize(right.xyz * n.x + up.xyz * n.y + ahead.xyz * n.z); }
+
+struct Guide {
+    float4 albedo : SV_Target0;    // the picture's colour, alpha 1 where the surface is the scene's
+    float4 normal : SV_Target1;    // world normal, roughness
+    float4 specular : SV_Target2;  // specular albedo
+    float hit : SV_Target3;        // the reflections' hit distance, theirs to write
+};
+
+Guide ps(float4 pos : SV_Position) {
+    Guide o;
+    o.albedo = float4(1, 1, 1, 0);
+    o.normal = float4(-ahead.xyz, 1);  // toward the eye
+    o.specular = 0;
+    o.hit = 0;
+    int2 px = int2(pos.xy);
+    float3 p = ViewPos(px, depth.Load(int3(px, 0)));
+    if (p.z >= 0.999 * max(cam.x, cam.y)) return o;
+    float len = length(p);
+    float3 dir = p / len;
+    uint geom, prim;
+    float2 bary;
+    float t = TraceScene(0, dir, 0, 1e30f, 32, geom, prim, bary);
+    if (t < 0 || abs(t - len) > 0.02f * len) return o;
+    Draw g = geo[geom];
+    Spot s = SpotOf(geom, prim, bary);
+    float3 n = Facing(s.p[0], s.p[1], s.p[2], dir);
+    if (all(n == 0)) return o;
+    float footprint = t * 2 * cam.w / part.y;
+    float3 albedo = 1;
+    if (g.a.z != kNone) {
+        Texture2D<float4> pic = pictures[NonUniformResourceIndex(g.a.z)];
+        albedo = pic.SampleLevel(wrap, s.at, LevelOf(pic, s, footprint)).rgb;
+    }
+    float rough = 1, metal = 0;
+    if (g.b.x != kNone) {
+        Texture2D<float4> orm = pictures[NonUniformResourceIndex(g.b.x)];
+        float3 m = orm.SampleLevel(wrap, s.at, LevelOf(orm, s, footprint)).rgb;
+        rough = clamp(g.c.x > 0 ? g.c.x + m.g - 0.8f : m.g + asfloat(g.b.z), 0.04f, 1);
+        metal = max(saturate(m.b * asfloat(g.b.w)), g.c.y);
+    }
+    if (g.b.y != kNone) {
+        // the normal map's relief (tangent space, x along u, y down the picture)
+        float3 e1 = s.p[1] - s.p[0], e2 = s.p[2] - s.p[0];
+        float2 d1 = s.uv[1] - s.uv[0], d2 = s.uv[2] - s.uv[0];
+        float det = d1.x * d2.y - d1.y * d2.x;
+        if (abs(det) > 1e-20f) {
+            float3 tg = (e1 * d2.y - e2 * d1.y) / det, bt = (e2 * d1.x - e1 * d2.x) / det;
+            tg -= n * dot(n, tg);
+            bt -= n * dot(n, bt);
+            if (dot(tg, tg) > 1e-20f && dot(bt, bt) > 1e-20f) {
+                Texture2D<float4> nm = pictures[NonUniformResourceIndex(g.b.y)];
+                float3 tn = nm.SampleLevel(wrap, s.at, LevelOf(nm, s, footprint)).rgb * 2 - 1;
+                tn.z = max(tn.z, 0.05f);
+                float3 bent = normalize(tg) * tn.x - normalize(bt) * tn.y + n * tn.z;
+                if (dot(bent, bent) > 1e-12f) n = normalize(bent);
+            }
+        }
+    }
+    o.albedo = float4(albedo, 1);
+    o.normal = float4(ToWorld(n), rough);
+    if (g.b.x != kNone)
+        o.specular = float4(SpecularAlbedo(lerp(float3(0.04f, 0.04f, 0.04f), saturate(albedo), metal), rough,
+                                           saturate(dot(n, -dir))), 1);
+    return o;
+}
diff --git a/runtime/gpu/rt_refl.hlsl b/runtime/gpu/rt_refl.hlsl
new file mode 100644
index 0000000..95621e8
--- /dev/null
+++ b/runtime/gpu/rt_refl.hlsl
@@ -0,0 +1,130 @@
+// Ray traced reflections (raytrace.cpp, DXR 1.1 inline ray queries, compiled to DXIL when the runtime is built): each
+// pixel of the frame's 3D whose surface has a texture pack's material (its ORM map: roughness, metalness) and is
+// smooth enough sends one ray into the frame's scene (the world's draws as drawn, raytrace.h) along its mirror
+// direction, spread over a cone as wide as its roughness, and takes on what the ray meets: that draw's picture at the
+// point, times its vertices' colour (the light the game gave them). The share is the surface's Fresnel reflectance,
+// its picture's colour on metal, faded out as roughness grows; a ray that meets nothing leaves the pixel as it was.
+// Drawn over the frame's 3D before anti-aliasing, which gathers its noise over the frames as it does ambient
+// occlusion's: the colour added (premultiplied), metal's own colour taken out by the alpha. Its second target, when
+// the guides are drawn (rt_guide.hlsl), takes each ray's length, which DLSS Ray Reconstruction moves the reflection by.
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), its size drawn (w, h)
+    float4 rf;    // strength, the roughness where reflections have faded out, the farthest a ray reaches, and a
+                  // roughness every material is taken to have (XBE_RT_REFL_FORCE, to see them; 0 the maps')
+    float4 fr;    // the frame's number, XBE_RT_VIEW, the rays' start off the surface: a constant and a part of the depth
+};
+#include "rt_scene.hlsli"
+Texture2D<float> depth : register(t1);
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float Depth(int2 px) { return depth.Load(int3(clamp(px, int2(0, 0), int2(part.xy) - 1), 0)); }
+float3 ViewPos(int2 px, float d) {
+    float2 uv = (float2(px) + 0.5) / part.xy;
+    float z = ViewZ(d);
+    return float3((uv.x * 2 - 1) * cam.z * z, (1 - uv.y * 2) * cam.w * z, z);
+}
+float Hash(uint3 v) {
+    v = v * 1664525u + 1013904223u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    v ^= v >> 16u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    return float(v.x & 0xFFFFFF) / 16777216.0f;
+}
+
+struct Out {
+    float4 color : SV_Target0;
+    float hit : SV_Target1;  // how far the ray went, 0 where none was sent or it met nothing
+};
+Out Done(float4 c, float hit) {
+    Out o;
+    o.color = c;
+    o.hit = hit;
+    return o;
+}
+
+Out ps(float4 pos : SV_Position) {
+    uint2 id = uint2(pos.xy);
+    int2 px = int2((float2(id) + 0.5) * part.xy / part.zw);
+    float3 p = ViewPos(px, Depth(px));
+    if (p.z >= 0.999 * max(cam.x, cam.y)) return Done(0, 0);  // nothing drawn there
+    // the surface: the scene's, where the frame drew it
+    float len = length(p);
+    float3 dir = p / len;
+    uint geom, prim;
+    float2 bary;
+    float t = TraceScene(0, dir, 0, 1e30f, 32, geom, prim, bary);
+    if (t < 0 || abs(t - len) > 0.02f * len) return Done(0, 0);
+    Draw g = geo[geom];
+    if (g.b.x == kNone) return Done(0, 0);  // no material: the game's own surfaces stay as it drew them
+    Spot s = SpotOf(geom, prim, bary);
+    float pixel = 2 * cam.w / part.y;  // a pixel's height at a distance of one
+    Texture2D<float4> orm = pictures[NonUniformResourceIndex(g.b.x)];
+    float3 m = orm.SampleLevel(wrap, s.at, LevelOf(orm, s, t * pixel)).rgb;
+    // the map's, else the game's gloss for the material (the pack's maps are too rough to reflect), varied as the map
+    // varies about its usual 0.8
+    float rough = rf.w > 0 ? rf.w : clamp(g.c.x > 0 ? g.c.x + m.g - 0.8f : m.g + asfloat(g.b.z), 0.04f, 1);
+    float metal = max(saturate(m.b * asfloat(g.b.w)), g.c.y);
+    // XBE_RT_VIEW 6: the roughness (black smooth), 7: the metalness
+    if (fr.y == 6) return Done(float4(rough.xxx, 1), 0);
+    if (fr.y == 7) return Done(float4(metal.xxx, 1), 0);
+    float fade = saturate((rf.y - rough) / (0.5f * rf.y));  // whole below half the limit, none at it
+    if (fade <= 0) return Done(0, 0);
+    // its normal: the face's, bent by its normal map (tangent space, x along u, y along v)
+    float3 n = Facing(s.p[0], s.p[1], s.p[2], dir);
+    if (all(n == 0)) return Done(0, 0);
+    if (g.b.y != kNone) {
+        float3 e1 = s.p[1] - s.p[0], e2 = s.p[2] - s.p[0];
+        float2 d1 = s.uv[1] - s.uv[0], d2 = s.uv[2] - s.uv[0];
+        float det = d1.x * d2.y - d1.y * d2.x;
+        if (abs(det) > 1e-20f) {
+            float3 tg = (e1 * d2.y - e2 * d1.y) / det, bt = (e2 * d1.x - e1 * d2.x) / det;
+            tg -= n * dot(n, tg);
+            bt -= n * dot(n, bt);
+            if (dot(tg, tg) > 1e-20f && dot(bt, bt) > 1e-20f) {
+                Texture2D<float4> nm = pictures[NonUniformResourceIndex(g.b.y)];
+                float3 tn = nm.SampleLevel(wrap, s.at, LevelOf(nm, s, t * pixel)).rgb * 2 - 1;
+                tn.z = max(tn.z, 0.05f);
+                // the map's y runs down the picture: toward -v
+                float3 bent = normalize(tg) * tn.x - normalize(bt) * tn.y + n * tn.z;
+                if (dot(bent, bent) > 1e-12f) n = normalize(bent);
+            }
+        }
+    }
+    // the half vector drawn from the GGX lobe of its roughness about the normal (alpha = roughness squared), one a
+    // pixel and frame, so the frames gather a rough surface's blur
+    float a = rough * rough;
+    float u1 = Hash(uint3(id, uint(fr.x))), u2 = Hash(uint3(id.yx + 7919u, uint(fr.x) + 1013u));
+    float ct = sqrt((1 - u1) / (1 + (a * a - 1) * u1)), st = sqrt(1 - ct * ct), ph = 6.2831853f * u2;
+    float3 t0 = normalize(abs(n.y) < 0.99f ? cross(n, float3(0, 1, 0)) : cross(n, float3(1, 0, 0)));
+    float3 b0 = cross(n, t0);
+    float3 h = normalize(t0 * (st * cos(ph)) + b0 * (st * sin(ph)) + n * ct);
+    float3 r = reflect(dir, h);
+    if (dot(r, n) <= 0) r = reflect(dir, n);
+    float3 o = dir * t + n * (fr.z + fr.w * t);
+    uint g2, p2;
+    float2 b2;
+    float t2 = TraceScene(o, r, 0, rf.z, 16, g2, p2, b2);
+    if (t2 < 0) return Done(0, 0);  // nothing within reach: the frame keeps its own
+    // what it meets: its picture there times its vertices' colour, its picture read as blurred as the cone is wide
+    Spot hs = SpotOf(g2, p2, b2);
+    float3 seen = hs.tint.rgb;
+    uint pic = geo[g2].a.z;
+    if (pic != kNone) {
+        Texture2D<float4> pt = pictures[NonUniformResourceIndex(pic)];
+        float cone = (t + t2) * pixel + t2 * a;
+        seen *= pt.SampleLevel(wrap, hs.at, LevelOf(pt, hs, cone)).rgb;
+    }
+    if (fr.y == 5) return Done(float4(seen, 1), t2);  // XBE_RT_VIEW 5: what the rays meet alone
+    // Fresnel's reflectance (Schlick's), metal's tinted by its own picture
+    float3 base = s.tint.rgb;
+    if (g.a.z != kNone) {
+        Texture2D<float4> bt2 = pictures[NonUniformResourceIndex(g.a.z)];
+        base *= bt2.SampleLevel(wrap, s.at, LevelOf(bt2, s, t * pixel)).rgb;
+    }
+    float3 f0 = lerp(float3(0.04f, 0.04f, 0.04f), saturate(base), metal);
+    float3 f = f0 + (1 - f0) * pow(1 - saturate(dot(-dir, h)), 5);
+    // fading as the ray nears its reach, so where it ends does not draw a line
+    float w = rf.x * fade * saturate(4 * (1 - t2 / rf.z));
+    return Done(float4(seen * f * w, metal * w * max(f.r, max(f.g, f.b))), t2);
+}
diff --git a/runtime/gpu/rt_scene.hlsli b/runtime/gpu/rt_scene.hlsli
new file mode 100644
index 0000000..52518f6
--- /dev/null
+++ b/runtime/gpu/rt_scene.hlsli
@@ -0,0 +1,132 @@
+// The frame's scene for ray tracing's passes (raytrace.h, rt_*.hlsl): its acceleration structure and what a hit is.
+// A pass declares its constants first, cam among them: the view's depth at the buffer's 0 and its 1, tan of half the
+// view across, down (cam.zw put a captured vertex back into view space, as the scene's instance does).
+RaytracingAccelerationStructure scene : register(t0);
+// the frame's captured vertices (32 bytes: clip x, y, w, z; u, v; colour RGBA8; index), its indices (32 bit) and its
+// draws (GeometryEntry)
+ByteAddressBuffer verts : register(t2);
+ByteAddressBuffer inds : register(t3);
+struct Draw {
+    uint4 a;  // first vertex, first index (~0: its vertices three by three), its picture (~0 none), its alpha test
+    uint4 b;  // its material's ORM map and normal map (~0 none), roughness bias and metalness scale (floats)
+    float4 c;  // its gloss (Material::gloss): roughness (0: the map's), metalness at least
+};
+StructuredBuffer<Draw> geo : register(t4);
+// the frame's pictures: the whole SRV heap, a draw's picture at its index
+Texture2D<float4> pictures[] : register(t0, space1);
+SamplerState wrap : register(s0);
+static const uint kNone = 0xFFFFFFFFu;
+
+// a captured vertex in view space
+float3 VertexView(uint v) {
+    float3 c = asfloat(verts.Load3(v * 32));
+    return float3(c.x * cam.z, c.y * cam.w, c.z);
+}
+// a triangle's three vertex slots
+uint3 Corners(uint4 g, uint prim) {
+    uint k = prim * 3;
+    return g.x + (g.y == kNone ? uint3(k, k + 1, k + 2) : inds.Load3((g.y + k) * 4));
+}
+// a face's normal toward the eye along d
+float3 Facing(float3 a, float3 b, float3 c, float3 d) {
+    float3 f = cross(b - a, c - a);
+    float l = length(f);
+    return l > 1e-12f ? f / l * (dot(f, d) > 0 ? -1.0f : 1.0f) : 0;
+}
+float3 FaceNormal(uint geom, uint prim, float3 d) {
+    uint3 i = Corners(geo[geom].a, prim);
+    return Facing(VertexView(i.x), VertexView(i.y), VertexView(i.z), d);
+}
+// a cut-out's triangle (alpha tested: leaves, railings, grates) is there where its picture is: its alpha, the picture's
+// (times the vertices' colour's when the draw's stages take that too), passes its test as the draw's did
+bool Solid(uint geom, uint prim, float2 bary) {
+    uint4 g = geo[geom].a;
+    uint3 i = Corners(g, prim);
+    float4 a = asfloat(verts.Load4(i.x * 32 + 16)), b = asfloat(verts.Load4(i.y * 32 + 16)),
+           c = asfloat(verts.Load4(i.z * 32 + 16));
+    float3 w = float3(1 - bary.x - bary.y, bary.x, bary.y);
+    float2 uv = a.xy * w.x + b.xy * w.y + c.xy * w.z;
+    float va = dot(float3(asuint(a.z) >> 24, asuint(b.z) >> 24, asuint(c.z) >> 24), w) / 255;
+    float alpha = pictures[NonUniformResourceIndex(g.z)].SampleLevel(wrap, uv, 0).a * ((g.w & 0x20000) ? va : 1.0f);
+    int v = (int)round(alpha * 255), r = (int)(g.w & 255), f = (int)((g.w >> 8) & 7);
+    return f == 0 ? false : f == 1 ? v < r : f == 2 ? v == r : f == 3 ? v <= r : f == 4 ? v > r : f == 5 ? v != r
+         : f == 6 ? v >= r : true;
+}
+
+// the nearest thing along a ray between tmin and tmax: its distance (-1 for none), which triangle of which draw, and
+// where on it (barycentrics of its second and third corners). Cut-outs are tested up to budget times a ray, then the
+// ray ends with what it met so far: a room's thousand leaves or a long run of railings cost a ray no more than that
+// (unbounded, a frame's long reflections through them took the GPU past Windows' two seconds)
+float TraceScene(float3 o, float3 d, float tmin, float tmax, int budget, out uint geom, out uint prim, out float2 bary) {
+    RayDesc r;
+    r.Origin = o;
+    r.Direction = d;
+    r.TMin = tmin;
+    r.TMax = tmax;
+    RayQuery<RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> q;
+    q.TraceRayInline(scene, RAY_FLAG_NONE, 0xFF, r);
+    while (q.Proceed()) {
+        if (q.CandidateType() != CANDIDATE_NON_OPAQUE_TRIANGLE) continue;
+        if (budget-- <= 0) {
+            q.Abort();
+            break;
+        }
+        if (Solid(q.CandidateGeometryIndex(), q.CandidatePrimitiveIndex(), q.CandidateTriangleBarycentrics()))
+            q.CommitNonOpaqueTriangleHit();
+    }
+    geom = prim = 0;
+    bary = 0;
+    if (q.CommittedStatus() != COMMITTED_TRIANGLE_HIT) return -1;
+    geom = q.CommittedGeometryIndex();
+    prim = q.CommittedPrimitiveIndex();
+    bary = q.CommittedTriangleBarycentrics();
+    return q.CommittedRayT();
+}
+float TraceScene(float3 o, float3 d, float tmin, float tmax, int budget, out uint geom, out uint prim) {
+    float2 bary;
+    return TraceScene(o, d, tmin, tmax, budget, geom, prim, bary);
+}
+float TraceScene(float3 o, float3 d, float tmin, float tmax, int budget) {
+    uint geom, prim;
+    float2 bary;
+    return TraceScene(o, d, tmin, tmax, budget, geom, prim, bary);
+}
+
+// a hit's triangle as drawn: its corners in view space, texture coordinates and colours, and the point's own
+struct Spot {
+    float3 p[3];
+    float2 uv[3];
+    float4 col[3];
+    float2 at;   // the point's texture coordinates
+    float4 tint;  // and colour
+};
+Spot SpotOf(uint geom, uint prim, float2 bary) {
+    Spot s;
+    uint3 i = Corners(geo[geom].a, prim);
+    float3 w = float3(1 - bary.x - bary.y, bary.x, bary.y);
+    [unroll] for (int k = 0; k < 3; k++) {
+        uint v = k == 0 ? i.x : k == 1 ? i.y : i.z;
+        s.p[k] = VertexView(v);
+        uint4 e = verts.Load4(v * 32 + 16);
+        s.uv[k] = asfloat(e.xy);
+        s.col[k] = float4(e.z & 255, (e.z >> 8) & 255, (e.z >> 16) & 255, e.z >> 24) / 255;
+    }
+    s.at = s.uv[0] * w.x + s.uv[1] * w.y + s.uv[2] * w.z;
+    s.tint = s.col[0] * w.x + s.col[1] * w.y + s.col[2] * w.z;
+    return s;
+}
+// the level of detail to read a picture at over a triangle, for a footprint this wide in view units
+float LevelOf(Texture2D<float4> t, Spot s, float footprint) {
+    float w, h;
+    t.GetDimensions(w, h);
+    float world = length(cross(s.p[1] - s.p[0], s.p[2] - s.p[0]));
+    float2 a = (s.uv[1] - s.uv[0]) * float2(w, h), b = (s.uv[2] - s.uv[0]) * float2(w, h);
+    float texels = abs(a.x * b.y - a.y * b.x);
+    return 0.5f * log2(max(texels / max(world, 1e-12f) * footprint * footprint, 1e-12f));
+}
+
+// a full screen triangle for a pass drawn as a pixel shader (its textures are pixel shader resources)
+float4 vs(uint id : SV_VertexID) : SV_Position {
+    float2 uv = float2((id << 1) & 2, id & 2);
+    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);
+}
