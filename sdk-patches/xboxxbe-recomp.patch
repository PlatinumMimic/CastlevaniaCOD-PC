diff --git a/tools/recomp/codegen_emit.cpp b/tools/recomp/codegen_emit.cpp
index dadfc8e..8ff7df0 100644
--- a/tools/recomp/codegen_emit.cpp
+++ b/tools/recomp/codegen_emit.cpp
@@ -309,6 +309,22 @@ bool CodeGen::Run() {
     WriteIfChanged(out_ / "exports.def", library + exports);
     WriteIfChanged(out_ / "imports.def", library + exports + aliases);
 
+    // Linux has no import library: the executable reaches each body through a stub of the body's name, which looks it
+    // up in the loaded library once. Hidden, so the library never binds to a stub; the executable's overrides keep
+    // their names, which the library takes (game_code.cpp's version script).
+    std::string stubs =
+        "// written by xbe_recomp: the game code library's bodies as the executable calls them (Linux)\n"
+        "#include \"cpu/x86_ops.h\"\n\n"
+        "X86_HOST_API void* x86_code_symbol(const char* name);  // cpu/dispatch.cpp\n\n"
+        "#define X86_HOST_STUB(name)                                                                         \\\n"
+        "    extern \"C\" __attribute__((weak, visibility(\"hidden\"))) void name(X86Context& __restrict ctx, uint8_t* base) { \\\n"
+        "        static auto* body = reinterpret_cast<void (*)(X86Context&, uint8_t*)>(x86_code_symbol(#name));     \\\n"
+        "        body(ctx, base);                                                                                 \\\n"
+        "    }\n\n";
+    for (const std::vector<uint32_t>* list : {&funcs, &absent})
+        for (uint32_t f : *list) stubs += F("X86_HOST_STUB(__imp__%s)\n", FuncName(f).c_str());
+    WriteIfChanged(out_ / "x86_host_stubs.cpp", stubs);
+
     std::string stats = F("functions %zu\ninstructions %zu\n", funcs.size(), insn_count_);
     for (auto& [k, v] : unimpl_) stats += F("unimplemented %s %zu\n", k.c_str(), v);
     WriteIfChanged(out_ / "x86_recomp_stats.txt", stats);
